{
  "expo": {
    "name": "CLIMONASA",
    "slug": "climonasa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "climonasa",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#003850"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.climonasa.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CLIMONASA uses your location to fetch accurate climate data for irrigation recommendations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#003850"
      },
      "package": "com.climonasa.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow CLIMONASA to use your location for irrigation recommendations."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "42ed45a7-a1cb-4a88-88a3-629e47ad9dd6"
      }
    },
    "owner": "marinamiw"
  }
}
