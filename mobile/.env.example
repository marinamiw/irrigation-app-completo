# URL da API do backend (irrigation-app-nasa-data)
# Em desenvolvimento: IP da sua máquina na rede local (não use localhost em dispositivo físico)
# Descubra seu IP com: ipconfig (Windows) ou ifconfig (Mac/Linux)
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000

# Em produção: URL do servidor deployado
# EXPO_PUBLIC_API_URL=https://api.climonasa.com